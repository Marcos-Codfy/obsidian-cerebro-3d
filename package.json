{
  "name": "cerebro-3d",
  "version": "3.4.0",
  "description": "Plugin do Obsidian: notas como neurônios dentro de um cérebro anatômico 3D.",
  "author": "Marcos Vinicius Muniz Arruda (https://github.com/Marcos-Codfy)",
  "license": "SEE LICENSE IN LICENSE",
  "repository": "github:Marcos-Codfy/obsidian-cerebro-3d",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=cjs --platform=browser --target=es2020 --external:obsidian --external:electron --external:fs --external:path --external:os --minify --outfile=main.js",
    "build:teste": "node test/gerar.js test/dados.js && esbuild test/entry.js --bundle --format=iife --alias:obsidian=./test/obsidian-mock.js --outfile=test/bundle.js",
    "demo": "node test/demo.js && esbuild test/entry.js --bundle --format=iife --alias:obsidian=./test/obsidian-mock.js --outfile=test/bundle.js",
    "servir": "python -m http.server 8765",
    "gravar": "node tools/gravar-demo.js",
    "instalar": "node tools/instalar.js",
    "malhas": "python -I tools/converter_malha.py dados_brutos/fsaverage5 src/cena/malhas/fsaverage5.js && python -I tools/converter_cerebelo.py dados_brutos/suit_cerebelo/PIAL_FSL.surf.gii src/cena/malhas/cerebelo_suit.js"
  },
  "dependencies": {
    "3d-force-graph": "1.77.0",
    "three-spritetext": "1.9.6"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "playwright": "^1.56.1"
  }
}
